{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Pill",
  "version": "3.0.0",
  "identifier": "com.thepill.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pill",
        "title": "The Pill",
        "width": 480,
        "height": 8,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "./installer.nsi",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
